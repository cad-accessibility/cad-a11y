**/__pycache__/
*.py[cod]
model.stl
*.step
*.scad
*.png
scripts/*.stl
scripts/*.step
scripts/*.scad
swell_prints
backup_scripts
.DS_Store

# Runtime output (generated by the server) — keep the placeholder so dirs exist on clone
# data/models is now a runtime directory seeded from builtin_models/ at startup;
# the tracked built-ins live in builtin_models/ so uploads and ingested files
# never end up committed or baked into the Docker image.
data/models/*
!data/models/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/renders/*
!data/renders/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/db/*
!data/db/.gitkeep
/renders/
/study_logs/

# Local environment and secrets
.env
