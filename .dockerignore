# Version control
.git/
.github/
.gitlab-ci.yml

# Local tooling / IDE
.claude/
.DS_Store
.env
.env.*
!.env.example

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build outputs
build/
dist/

# Runtime data (not needed in the image — handled by volumes)
data/renders/
data/logs/
study_logs/
renders/

# Dev-only files
# scripts/* rather than scripts/ so the exception below is still considered:
# excluding the directory itself prunes the whole subtree and the ! never applies.
scripts/*
# Maintenance scripts an operator has to run inside the container. The data
# directories are Docker-managed volumes, so they are not conveniently reachable
# from the host and this cannot be run from outside.
!scripts/cleanup_ingest_models.py
# The container's entrypoint. Without this exception the COPY above it fails the
# build outright, since scripts/* has already pruned it from the context.
!scripts/docker-entrypoint.sh
tests/
server_cube_slider.py
requirements-dev.txt
*.md
*.spec
*.ps1
